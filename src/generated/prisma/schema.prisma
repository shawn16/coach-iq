// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (for coaches)
model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique // Email can be null initially for some flows
  emailVerified       DateTime? // When email was verified
  image               String? // Profile image URL
  passwordHash        String? // For Credentials provider
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz
  accounts            Account[] // Relation to OAuth accounts
  sessions            Session[] // Relation to user sessions
  athletes            Athlete[] // Relation to athletes managed by this coach
  trainingPlans       TrainingPlan[] // Relation to training plans created by this coach
  workoutLibraryItems WorkoutLibraryItem[] // Relation to workout library items created by this coach

  @@index([email], name: "idx_user_email")
  @@index([deletedAt], name: "idx_user_deleted_at")
  @@map("users")
}

// NextAuth Models

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Athlete model
model Athlete {
  id                   Int                   @id @default(autoincrement())
  firstName            String                @map("first_name")
  lastName             String                @map("last_name")
  birthday             DateTime              @db.Date
  grade                Int
  time1600m            Int                   @map("time_1600m")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz
  coachId              String                @map("coach_id")
  coach                User                  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workoutResults       WorkoutResult[]
  trainingPlanAthletes TrainingPlanAthlete[]

  @@index([coachId], name: "idx_athlete_coach")
  @@index([lastName, firstName], name: "idx_athlete_name")
  @@index([deletedAt], name: "idx_athlete_deleted_at")
  @@map("athletes")
}

// Enhanced Training Plan model
model TrainingPlan {
  id            String                @id @default(cuid())
  title         String
  description   String?               @db.Text
  duration      String
  durationWeeks Int                   @map("duration_weeks")
  startDate     DateTime              @map("start_date")
  endDate       DateTime              @map("end_date")
  progress      Int?
  type          String?
  planType      String?               @map("plan_type")
  totalWorkouts Int?                  @map("total_workouts")
  isCompleted   Boolean               @default(false) @map("is_completed")
  deletedAt     DateTime?             @map("deleted_at") @db.Timestamptz
  userId        String                @map("user_id")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks         PlanWeek[]
  athletes      TrainingPlanAthlete[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([userId], name: "idx_training_plan_user_id")
  @@index([startDate], name: "idx_training_plan_start_date")
  @@index([endDate], name: "idx_training_plan_end_date")
  @@index([deletedAt], name: "idx_training_plan_deleted_at")
  @@map("training_plans")
}

// Many-to-many relationship between Training Plans and Athletes
model TrainingPlanAthlete {
  trainingPlan   TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  trainingPlanId String       @map("training_plan_id")
  athlete        Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId      Int          @map("athlete_id")
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@id([trainingPlanId, athleteId])
  @@index([athleteId])
  @@index([trainingPlanId])
  @@map("training_plan_athletes")
}

// Weekly plan data
model PlanWeek {
  id          String    @id @default(cuid())
  weekNumber  Int       @map("week_number")
  dateRange   String    @map("date_range")
  seasonPhase String?   @map("season_phase")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  trainingPlan   TrainingPlan  @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  trainingPlanId String        @map("training_plan_id")
  workouts       PlanWorkout[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([trainingPlanId, weekNumber])
  @@index([trainingPlanId])
  @@index([deletedAt], name: "idx_plan_week_deleted_at")
  @@map("plan_weeks")
}

// Workout types
model WorkoutType {
  id        String        @id @default(cuid())
  name      String
  color     String // CSS classes for styling
  workouts  PlanWorkout[]
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@index([deletedAt], name: "idx_workout_type_deleted_at")
  @@map("workout_types")
}

// Workout for a specific week and type
model PlanWorkout {
  id        String    @id @default(cuid())
  details   String    @db.Text
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  week          PlanWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId        String      @map("week_id")
  workoutType   WorkoutType @relation(fields: [workoutTypeId], references: [id])
  workoutTypeId String      @map("workout_type_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([weekId, workoutTypeId])
  @@index([weekId])
  @@index([workoutTypeId])
  @@index([deletedAt], name: "idx_plan_workout_deleted_at")
  @@map("plan_workouts")
}

enum WorkoutTypeEnum {
  RUN
  WORKOUT
  RACE
  OTHER
}

// Workout Result model (Simplified for now)
model WorkoutResult {
  id        String          @id @default(cuid())
  athleteId Int             @map("athlete_id")
  athlete   Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date      DateTime
  type      WorkoutTypeEnum
  details   Json
  notes     String?
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId])
  @@index([date])
  @@index([deletedAt], name: "idx_workout_result_deleted_at")
  @@map("workout_results")
}

// Model for the Workout Library
model WorkoutLibraryItem {
  id          String    @id @default(cuid())
  name        String
  type        String
  category    String
  duration    String
  description String?   @db.Text
  icon        String?
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deletedAt], name: "idx_workout_library_item_deleted_at")
  @@map("workout_library_items")
}
